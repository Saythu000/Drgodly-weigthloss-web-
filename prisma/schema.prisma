datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

model StaffUser {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  role      String   @default("AGENT") // ADMIN, DOCTOR, AGENT
  password  String
  createdAt DateTime @default(now())
}

model Lead {
  id                  String   @id @default(uuid())
  phoneNumber         String   @unique
  name                String?
  age                 Int?
  bmi                 Float?
  healthFlags         Json?
  preferredMedication String?
  intakeStatus        String   @default("IN_PROGRESS") // IN_PROGRESS, DOCTOR_REVIEW, APPROVED, REJECTED
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model ConnectedAccount {
  id                String    @id @default(uuid())
  platform          String    // FACEBOOK, INSTAGRAM, LINKEDIN, YOUTUBE
  accountName       String?
  externalAccountId String?
  accessToken       String
  refreshToken      String?
  expiresAt         DateTime?
  status            String?   @default("ACTIVE")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model MediaAsset {
  id        String      @id @default(uuid())
  filename  String
  fileUrl   String
  mimeType  String
  fileSize  BigInt
  createdAt DateTime    @default(now())
  PostDraft PostDraft[]
}

model PostDraft {
  id             String        @id @default(uuid())
  title          String
  masterCaption  String
  type           String        @default("ORGANIC") // ORGANIC, PAID
  budget         Float?
  targetAudience String?
  mediaAssetId   String?
  mediaAsset     MediaAsset?   @relation(fields: [mediaAssetId], references: [id])
  createdAt      DateTime      @default(now())
  PostTarget     PostTarget[]
  PublishJob     PublishJob[]
}

model PostTarget {
  id            String    @id @default(uuid())
  draftId       String
  draft         PostDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  platform      String    // FACEBOOK, INSTAGRAM, LINKEDIN, YOUTUBE
  customCaption String?
  status        String    @default("READY")
}

model PublishJob {
  id           String    @id @default(uuid())
  draftId      String
  draft        PostDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  platform     String    // FACEBOOK, INSTAGRAM, LINKEDIN, YOUTUBE
  jobStatus    String    @default("PENDING") // PENDING, PUBLISHING, SUCCESS, FAILED
  attempts     Int       @default(0)
  externalUrl  String?
  errorMessage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model WhatsappOrder {
  id              String   @id @default(uuid())
  userId          String
  productName     String
  price           Decimal
  shippingAddress String
  paymentMethod   String
  status          String   @default("PENDING_COD")
  createdAt       DateTime @default(now())
  metadata        Json?
}

model Intake {
  id             String    @id @default(uuid())
  userId         String
  firstName      String
  lastName       String
  email          String
  phone          String
  shippingState  String?
  height         Float?
  weight         Float?
  goalWeight     Float?
  gender         String?
  dateOfBirth    DateTime?
  healthData     Json?
  history        Json?
  preferences    Json?
  additionalInfo String?
  createdAt      DateTime  @default(now())
}

model Eligibility {
  id        String   @id @default(uuid())
  userId    String
  status    String   // eligible, not_eligible
  reason    String?
  createdAt DateTime @default(now())
}


